{
  "name": "backend",
  "private": true,
  "version": "0.1.0",
  "main": "dist/server.js",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run start:server",
    "start:server": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start:worker": "npm run start:temporal-worker",
    "start:temporal-worker": "ts-node-dev --respawn --transpile-only src/temporalWorker.ts",
    "test:e2e": "npm run build && node --test test/e2e/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@openai/agents": "^0.1.9",
    "@temporalio/activity": "^1.18.1",
    "@temporalio/client": "^1.18.1",
    "@temporalio/worker": "^1.18.1",
    "@temporalio/workflow": "^1.18.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^16.4.5",
    "ws": "^8.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.21",
    "@types/ws": "^8.5.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  }
}
